# Copy to .env for local `netlify dev` use. Never commit the real values.

# Option A: paste the full service account JSON as one line
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# Option B: split into two vars (private key with literal \n line breaks)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

